{
  "name": "watten",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless service on Cloudflare that tracks Swedish electricity prices and thunderstorm forecasts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github_consid:oskarakerlund-consid/watten.git"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts --reporter=verbose",
    "typecheck": "wrangler types && tsc --noEmit && svelte-check --tsconfig web/tsconfig.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply watten --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
