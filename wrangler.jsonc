{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watten",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The Svelte app, built by `npm run build:web`. Served as free static assets; only /api/* runs the Worker.
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watten",
      "database_id": "054798df-d69c-4fc2-813f-6dd7340b824d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Price classification, see README "Configuration". Change here and redeploy.
    "MIN_PRICE_DIFF_ORE_PER_KWH": 20,
    "PRICE_DIFF_PERCENT": 20,
    "AVERAGE_WINDOW_HOURS": 48,
    // Thunder counts as expected in an hour from this probability (%).
    "THUNDER_PROBABILITY_PERCENT": 20,
    // No price alerts from 22:00 to 07:00 Swedish time (equal hours: none). Thunder alerts are always sent.
    "PRICE_ALERT_QUIET_FROM_HOUR": 22,
    "PRICE_ALERT_QUIET_TO_HOUR": 7,
    // Identifies this app to MET Norway, as their terms of service require.
    "MET_USER_AGENT": "watten/0.1 (https://github.com/oskarakerlund-consid/watten)",
    // Web Push. The public key is not a secret; the private key is set with `wrangler secret put VAPID_PRIVATE_KEY`.
    // Push endpoints answer 503 until both keys are set. See README "Configuration".
    "VAPID_PUBLIC_KEY": "BIC1RXwZC4_K851gT-hRC7jPPyuQHJVolptccGdee3jYDgIAl_T1otsxhF8ov2igzQmvmbAsHuuMqa68snffIlU",
    "VAPID_SUBJECT": "https://github.com/oskarakerlund-consid/watten"
  },
  "secrets": {
    "required": ["VAPID_PRIVATE_KEY"]
  },
  // Workers Logs: per-invocation logs with CPU time in the dashboard. Free plan: 200,000 events/day, kept 3 days.
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Price ingestion every 15 minutes; a run only fetches missing days, so most runs do one D1 read.
    // Alerts every 5 minutes, starting 2 minutes after each ingestion. Both must match the constants in src/index.ts.
    "crons": ["*/15 * * * *", "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"]
  }
}
