{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watten",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watten",
      "database_id": "054798df-d69c-4fc2-813f-6dd7340b824d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Price classification, see README "Configuration". Change here and redeploy.
    "MIN_PRICE_DIFF_ORE_PER_KWH": 20,
    "PRICE_DIFF_PERCENT": 20,
    "AVERAGE_WINDOW_HOURS": 48
  },
  "triggers": {
    // UTC. Covers 13:00 Swedish time (when tomorrow's prices are published) in both winter and summer time.
    "crons": ["*/15 11-14 * * *"]
  }
}
